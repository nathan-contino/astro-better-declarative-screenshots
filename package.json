{
  "name": "astro-better-declarative-screenshots",
  "version": "0.1.0",
  "type": "module",
  "description": "Declarative, Docker-backed screenshots for Astro docs. Define the page and the elements to highlight, and this produces a screenshot.",
  "exports": {
    ".": "./index.mjs",
    "./Screenshot.astro": "./Screenshot.astro",
    "./Highlight.astro": "./Highlight.astro"
  },
  "bin": {
    "take-screenshots": "./scripts/take-screenshots.mjs",
    "check-screenshots": "./scripts/check-screenshots.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "astro": ">=4.0.0"
  },
  "dependencies": {
    "playwright": "^1.45.0",
    "sharp": "^0.33.0",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "glob": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "vitest": "^2.0.0",
    "astro": "^4.0.0"
  },
  "keywords": ["astro", "screenshots", "declarative", "docs", "playwright", "integration"],
  "license": "MIT"
}
